ACS_CONNECTION_STRING=
EMAIL_SENDER=
CONTACT_RECIPIENT=jjfeore@gmail.com
# GitHub deployment bootstrap identifiers; these are not login credentials.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
